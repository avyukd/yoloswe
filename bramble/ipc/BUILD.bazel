load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ipc",
    srcs = [
        "client.go",
        "protocol.go",
        "server.go",
    ],
    importpath = "github.com/bazelment/yoloswe/bramble/ipc",
    visibility = ["//visibility:public"],
    deps = [
        "//agent-cli-wrapper/llmendpoint",
        "//bramble/session",
        "//bramble/sockguard",
